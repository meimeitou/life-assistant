# API 密钥（nanobot 主模型）
DEFAULT_API_KEY=sk-your-key-here
DEFAULT_API_BASE=https://api.openai.com/v1

# nanobot 主模型名称（不含 provider 前缀）
DEFAULT_MODEL=gpt-4o

# mem0 语义记忆模块（独立配置，不填则沿用 DEFAULT_API_KEY / DEFAULT_API_BASE）
# MEM0_API_KEY=sk-your-mem0-key
# MEM0_API_BASE=https://api.openai.com/v1
MEM0_MODEL=gpt-4o-mini
MEM0_EMBED_MODEL=text-embedding-3-small
